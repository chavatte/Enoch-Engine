{
  "name": "enoch-engine",
  "version": "1.1.0",
  "description": "The Arcane Node.js API Foundation. Robust, Secure, and Ready for the Unknown.",
  "author": "[DevChavatte] - João Carlos Chavatte",
  "license": "ISC",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "cross-env NODE_ENV=production node server.js",
    "dev": "cross-env NODE_ENV=development nodemon server.js",
    "test": "vitest",
    "test:ui": "vitest --ui --api 9500",
    "report": "cross-env NODE_ENV=development vite preview --outDir report/HTML",
    "db:migrate": "cross-env NODE_ENV=development sequelize-cli db:migrate --options-path .sequelizerc.cjs",
    "db:migrate:to": "cross-env NODE_ENV=development sequelize-cli db:migrate --to --options-path .sequelizerc.cjs",
    "db:migrate:undo": "cross-env NODE_ENV=development sequelize-cli db:migrate:undo --options-path .sequelizerc.cjs",
    "db:migrate:undo:to": "cross-env NODE_ENV=development sequelize-cli db:migrate:undo:all --to --options-path .sequelizerc.cjs",
    "db:migration:create": "cross-env NODE_ENV=development node scripts/create-migration.cjs",
    "usage": "cross-env NODE_ENV=development node scripts/help.cjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{js,cjs,mjs}": [
      "vitest related --run"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1165.0",
    "@dotenvx/dotenvx": "^2.38.2",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "express-validator": "^7.3.2",
    "file-type": "^22.3.0",
    "helmet": "^8.3.0",
    "js-yaml": "^5.5.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "sequelize": "^6.37.8",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "xss": "^1.0.17"
  },
  "devDependencies": {
    "@vitest/ui": "^5.1.0",
    "chalk": "^6.0.1",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "nodemon": "^3.1.14",
    "openapi-types": "^12.1.3",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.3.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "resolutions": {
    "flatted": "^3.4.2",
    "lodash": "^4.18.0",
    "ip-address": "^10.7.4",
    "postcss": "^8.5.10",
    "uuid": "^14.0.0",
    "brace-expansion": "^5.0.9",
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  },
  "packageManager": "yarn@4.18.1"
}
